{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"checkJs": true,
		"allowJs": true,
		"noEmit": true,
		"strict": false,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"maxNodeModuleJsDepth": 0
	},
	"include": ["src/**/*.js", "bin/**/*.js"]
}
